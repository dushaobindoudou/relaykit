{
  "name": "relaykit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "node scripts/build-config.mjs && next dev",
    "build": "node scripts/build-config.mjs && next build",
    "start": "next start",
    "test": "node scripts/build-config.mjs && vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "build:config": "node scripts/build-config.mjs",
    "typecheck:worker": "tsc -p tsconfig.worker.json --noEmit",
    "sync": "tsx scripts/sync-upstream.ts"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.44.7",
    "geist": "^1.7.2",
    "next": "^15.5.24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.6",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4.1.18",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.19.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.4",
    "drizzle-kit": "^0.31.6",
    "miniflare": "4.20260730.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "undici": "^8.10.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.131.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild"
    ]
  }
}
