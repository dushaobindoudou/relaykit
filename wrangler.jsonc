{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "daichong",
  // 自定义域：workers.dev 在中国大陆被 DNS 污染（解析到 108.160.166.253），
  // 目标客户全在大陆 —— 必须走自有域。freetokenbox.com 的既有受众
  // （AI 额度聚合）与代充店完全重合，shop. 子域承接。
  "routes": [
    { "pattern": "shop.freetokenbox.com", "custom_domain": true }
  ],
  "main": "worker/entry.ts",
  "compatibility_date": "2025-09-01",
  // nodejs_compat 是必须的：上游签名走 node:crypto 的 MD5，
  // 且 OpenNext 的 Next.js 运行时依赖多个 node: 内建模块。
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "relaykit",
      // 部署前由 `wrangler d1 create relaykit` 生成后填入，
      // 或用「Deploy to Cloudflare」按钮自动置备。
      "database_id": "39b0ac19-e0e3-4f95-bdff-1013f41085de",
      // drizzle-kit 把迁移生成在 ./drizzle，不是 wrangler 默认的 ./migrations
      "migrations_dir": "drizzle"
    }
  ],

  // 商品图/分类图的本地存储。上游图床是单点（imgurloss.xqd.cn，暂无防盗链
  // 但随时可能加），同步脚本把图下载压缩后推到这里，店面只引用自己的
  // /media/* 路径。首次部署前执行一次：`wrangler r2 bucket create relaykit-media`
  // ⚠️ 2026-09-14 暂时注释：账号尚未开通 R2（需在 Dashboard 同意 R2 条款，
  // API 做不了）。运行时两处 MEDIA 消费点都按可选处理（缺失时优雅降级），
  // 目录同步用 --no-images 让封面直连上游图床。开通 R2 后：
  //   1. 取消下面的注释  2. wrangler r2 bucket create relaykit-media
  //   3. 重跑 sync-upstream.ts（不带 --no-images）把图片本地化进 R2
  // "r2_buckets": [
  //   {
  //     "binding": "MEDIA",
  //     "bucket_name": "relaykit-media"
  //   }
  // ],

  // 后台任务不能是常驻进程 —— Workers 没有常驻。
  // 链上收款轮询与上游余额巡检都挂在 Cron 上，打到内部 API 路由。
  "triggers": {
    "crons": [
      "* * * * *",
      "*/15 * * * *"
    ]
  },

  "vars": {
    "DAICHONG_ENV": "production"
  }
}
